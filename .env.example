# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. `.env.example` is committed and must never contain a real secret.

# --- Step 1: Buffer (needed now) ------------------------------------------
# Buffer -> Settings -> API -> create a personal API key.
# Personal key, NOT an OAuth App Client: insights are unavailable to OAuth clients.
# Scopes: account:read, posts:read, insights:read.
BUFFER_API_KEY=

# Discovered by running: node --env-file=.env scripts/discover-buffer.mjs
BUFFER_ORG_ID=

# --- Later steps (leave blank until we get to them) -----------------------
# Handle (name.bsky.social) or DID. Prefer the DID — handles can be renamed.
BLUESKY_HANDLE=

# Meta (Instagram + Facebook follower levels). One System User token covers both.
# Use a SYSTEM USER token from Business Settings, not a user access token:
# user tokens expire every ~60 days and the nightly job would start failing.
# Both IDs come from Buffer channel discovery (the channel's serviceId).
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT=
